{
  "openapi": "3.1.0",
  "info": {
    "title": "FinCore Financial REST API",
    "description": "Production-grade Financial Platform REST API providing double-entry bookkeeping, digital wallets, atomic transfers, payment processing simulation, dispute management, and real-time risk analytics.",
    "version": "1.0.0"
  },
  "servers": [
    { "url": "http://localhost:4000/api/v1", "description": "Local Development Server" }
  ],
  "paths": {
    "/auth/login": {
      "post": {
        "summary": "User Authentication",
        "tags": ["Authentication"]
      }
    },
    "/wallets": {
      "get": {
        "summary": "List User Wallets",
        "tags": ["Wallets"]
      }
    },
    "/transfers": {
      "post": {
        "summary": "Atomic Double-Entry Transfer",
        "tags": ["Transfers"]
      }
    },
    "/payments/webhook": {
      "post": {
        "summary": "Signed Webhook Receiver",
        "tags": ["Payments"]
      }
    },
    "/disputes": {
      "post": {
        "summary": "Create Dispute",
        "tags": ["Disputes"]
      }
    },
    "/ledger/verify-invariants": {
      "get": {
        "summary": "Audit Ledger Invariants",
        "tags": ["Ledger"]
      }
    }
  }
}
