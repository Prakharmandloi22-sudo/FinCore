# ==============================================================================
# FinCore Environment Configuration Template
# All secrets must be provided securely; do not commit actual credentials!
# ==============================================================================

# Node.js Core Backend Configuration
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000

# Authentication & Security
JWT_SECRET=super-secret-jwt-key-change-in-production-min-32-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
MFA_SERVICE_SECRET=fincore-mfa-simulated-totp-secret-key-32
REAUTH_TOKEN_SECRET=fincore-sensitive-reauth-action-secret

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fincore_db
DB_USER=fincore_user
DB_PASSWORD=fincore_secure_password_replace_in_prod
DB_SSL=false
DATABASE_URL=postgresql://fincore_user:fincore_secure_password_replace_in_prod@localhost:5432/fincore_db

# Redis Cache & Queue
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# Python Analytics & Calculation Microservice
ANALYTICS_SERVICE_URL=http://localhost:8000
ANALYTICS_API_KEY=fincore-internal-service-key-7890

# Payment Provider Simulation (FinCorePay / MockStripe)
PAYMENT_WEBHOOK_SECRET=whsec_test_mock_webhook_secret_fincore_2026
PAYMENT_PROVIDER_API_KEY=pk_test_simulated_fincore_key_2026

# Email & SMS Sandbox Notifications
NOTIFICATION_SANDBOX_ENABLED=true
SMTP_HOST=sandbox.smtp.local
SMTP_PORT=1025
SMTP_USER=mock
SMTP_PASS=mock

# Logging & Observability
LOG_LEVEL=info
ENABLE_METRICS=true
